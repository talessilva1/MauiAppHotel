<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             BackgroundColor="{StaticResource Gray100}">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Shadow" Value="2 2 2 Black 0.3" />
        </Style>
        <Style TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Stroke" Value="Black" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
    </ContentPage.Resources>


    <VerticalStackLayout Padding="15"
                         VerticalOptions="Center"
                         BackgroundColor="{StaticResource Background}">
        <Label 
            Text="App Hotel"
            FontFamily="BowlbyOneRegular"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="48" />

        <Border Margin="0, 0, 0, 10">
            <VerticalStackLayout Padding="15">
                <HorizontalStackLayout>
                    <Label Text="Adulto(s): " />
                    <Label Text="{Binding QntAdultos}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Criança(s): " />
                    <Label Text="{Binding QntCriancas}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Quarto escolhido: " />
                    <Label Text="{Binding Path=QuartoEscolhido.Nome}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Estadia: " />
                    <Label Text="{Binding Estadia}" />
                    <Label Text=" dia(s)" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Border Margin="0, 0, 0, 10">
            <Grid Padding="15"
                  ColumnDefinitions="*, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Data Check-in:" />
                <DatePicker Grid.Row="0" Grid.Column="1" IsEnabled="False" Date="{Binding DataCheckin}" />
                <Label Grid.Row="1" Grid.Column="0" Text="Data Check-out:" />
                <DatePicker Grid.Row="1" Grid.Column="1" IsEnabled="False" Date="{Binding DataCheckout}" />
            </Grid>
        </Border>
        
        <Border>
            <HorizontalStackLayout Padding="15">
                <Label FontSize="24" Text="Valor final: R$" />
                <Label FontSize="24" Text="{Binding TotalHospedagem, StringFormat='{}{0:F2}'}" />
            </HorizontalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>